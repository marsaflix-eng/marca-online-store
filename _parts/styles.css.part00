/* Marça — Snapchat Plus gift store
   Dark elegant RTL UI, self-hosted, no CDNs */

:root {
  --bg-deep: #0a0a0c;
  --bg: #121214;
  --bg-elevated: #1a1a1f;
  --bg-card: #1e1e24;
  --bg-card-hover: #26262e;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.14);
  --text: #f5f5f7;
  --text-muted: #a1a1aa;
  --text-dim: #71717a;
  --accent: #fffc00;
  --accent-soft: rgba(255, 252, 0, 0.12);
  --accent-glow: rgba(255, 252, 0, 0.25);
  --success: #34d399;
  --success-soft: rgba(52, 211, 153, 0.15);
  --danger: #f87171;
  --danger-soft: rgba(248, 113, 113, 0.12);
  --whatsapp: #25d366;
  --whatsapp-hover: #1ebe57;
  --radius: 16px;
  --radius-sm: 10px;
  --radius-pill: 999px;
  --shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 0 40px var(--accent-glow);
  --font: "Segoe UI", "Tahoma", "Arial", "Noto Sans Arabic", sans-serif;
  --tap: 48px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --step-max: 520px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font);
  background: var(--bg-deep);
  color: var(--text);
  line-height: 1.6;
  min-height: 100dvh;
  direction: rtl;
  overflow-x: hidden;
}

/* Ambient background */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(255, 252, 0, 0.08), transparent),
    radial-gradient(ellipse 60% 40% at 100% 50%, rgba(255, 252, 0, 0.03), transparent),
    radial-gradient(ellipse 40% 30% at 0% 80%, rgba(255, 255, 255, 0.02), transparent),
    var(--bg-deep);
  pointer-events: none;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Layout */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  background: rgba(10, 10, 12, 0.85);
  border-bottom: 1px solid var(--border);
  padding: 0.85rem 1.25rem;
}

.header-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-weight: 700;
  font-size: 1.35rem;
  letter-spacing: -0.02em;
  color: var(--text);
  text-decoration: none;
}

.logo:hover {
  text-decoration: none;
}

.logo-mark {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(145deg, var(--accent) 0%, #e6e300 100%);
  color: #0a0a0c;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1rem;
  box-shadow: 0 2px 12px var(--accent-glow);
}

.header-tag {
  font-size: 0.75rem;
  color: var(--text-muted);
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-pill);
}

main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1.25rem 3rem;
}

/* Progress */
.progress-wrap {
  display: none;
  margin-bottom: 1.75rem;
  animation: fadeIn 0.4s var(--ease);
}

.progress-wrap.visible {
  display: block;
}

.progress-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.35rem;
  margin-bottom: 0.75rem;
}

.progress-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  position: relative;
}

.progress-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: 2px solid var(--border-strong);
  display: grid;
  place-items: center;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--text-dim);
  transition: all 0.35s var(--ease);
  z-index: 1;
}

.progress-step.active .progress-dot {
  background: var(--accent);
  border-color: var(--accent);
  color: #0a0a0c;
  box-shadow: 0 0 16px var(--accent-glow);
}

.progress-step.done .progress-dot {
  background: var(--success);
  border-color: var(--success);
  color: #0a0a0c;
}

.progress-label {
  font-size: 0.65rem;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.2;
}

.progress-step.active .progress-label {
  color: var(--accent);
  font-weight: 600;
}

.progress-step.done .progress-label {
  color: var(--success);
}

.progress-track {
  height: 3px;
  background: var(--bg-elevated);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--success), var(--accent));
  border-radius: var(--radius-pill);
  transition: width 0.45s var(--ease);
  width: 0%;
}

/* Panels / steps */
.panel {
  display: none;
  animation: slideIn 0.45s var(--ease);
}

.panel.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Hero */
.hero {
  text-align: center;
  padding: 1.5rem 0 2.5rem;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1px solid rgba(255, 252, 0, 0.25);
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-pill);
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
}

.hero h1 {
  font-size: clamp(1.75rem, 5vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.25;
  margin-bottom: 0.85rem;
}

.hero h1 span {
  background: linear-gradient(135deg, var(--accent), #fff8a0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  color: var(--text-muted);
  font-size: 1.05rem;
  max-width: 480px;
  margin: 0 auto 0.5rem;
}

.hero-note {
  color: var(--text-dim);
  font-size: 0.85rem;
}

/* Product cards */
.plans {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  margin-top: 0.5rem;
}

@media (min-width: 640px) {
  .plans {
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
    align-items: stretch;
  }
}

.plan-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem 1.25rem 1.35rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  cursor: pointer;
  transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
    background 0.3s var(--ease), box-shadow 0.3s var(--ease);
  text-align: center;
  min-height: var(--tap);
  -webkit-tap-highlight-color: transparent;
  appearance: none;
  font: inherit;
  color: inherit;
  width: 100%;
}

.plan-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-strong);
  transform: translateY(-4px);
  box-shadow: var(--shadow);
}

.plan-card:active {
  transform: translateY(-1px);
}

.plan-card.featured {
  border-color: rgba(255, 252, 0, 0.35);
  background: linear-gradient(180deg, rgba(255, 252, 0, 0.06) 0%, var(--bg-card) 50%);
  box-shadow: var(--shadow-glow);
}

.plan-card.featured:hover {
  border-color: var(--accent);
}

.plan-badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--accent);
  color: #0a0a0c;
  font-size: 0.7rem;
