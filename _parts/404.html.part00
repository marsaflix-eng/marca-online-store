<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0; url=./" />
  <script>location.replace("./");</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="مرصة — متجر هدايا اشتراك سناب شات بلس. الدفع عبر بنكيلي فقط." />
  <meta name="theme-color" content="#0a0a0c" />
  <meta name="robots" content="index,follow" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <title>مرصة — سناب شات بلس</title>
  <link rel="stylesheet" href="css/styles.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23fffc00'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-size='16' font-family='sans-serif' font-weight='800' fill='%230a0a0c'%3Eم%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="#" class="logo" id="logo-home" aria-label="مرصة — الصفحة الرئيسية">
        <span class="logo-mark" aria-hidden="true">م</span>
        <span>مرصة</span>
      </a>
      <span class="header-tag">Snapchat+</span>
    </div>
  </header>

  <main id="main">
    <!-- Progress (steps 1–3) -->
    <div class="progress-wrap" id="progress-wrap" aria-label="تقدّم الطلب">
      <div class="progress-bar" role="list">
        <div class="progress-step" data-progress-step="0" role="listitem">
          <span class="progress-dot" aria-hidden="true">1</span>
          <span class="progress-label">اسم السناب</span>
        </div>
        <div class="progress-step" data-progress-step="1" role="listitem">
          <span class="progress-dot" aria-hidden="true">2</span>
          <span class="progress-label">متابعة</span>
        </div>
        <div class="progress-step" data-progress-step="2" role="listitem">
          <span class="progress-dot" aria-hidden="true">3</span>
          <span class="progress-label">الدفع</span>
        </div>
      </div>
      <div class="progress-track" aria-hidden="true">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
    </div>

    <!-- Step 0: Plans -->
    <section class="panel active" id="panel-plans" aria-hidden="false" aria-labelledby="hero-title">
      <div class="hero">
        <div class="hero-badge">
          <span aria-hidden="true">✦</span>
          متجر رقمي موثوق
        </div>
        <h1 id="hero-title">اشترك في <span>سناب شات بلس</span><br />بسهولة وأمان</h1>
        <p class="hero-sub">مرصة — هدايا اشتراك سناب شات بلس بأسعار واضحة بالعملة الموريتانية.</p>
        <p class="hero-note">الدفع عبر بنكيلي فقط · لا نجمع بيانات بطاقة</p>
      </div>
      <div class="plans" id="plans-grid" role="list" aria-label="باقات الاشتراك"></div>
    </section>

    <!-- Step 1: Username -->
    <section class="panel" id="panel-username" aria-hidden="true" aria-labelledby="username-title">
      <div class="step-card">
        <h2 id="username-title">اسم مستخدم سناب شات</h2>
        <p class="step-desc">أدخل اسم الحساب الذي تريد تفعيل الاشتراك عليه.</p>
        <div class="selected-summary" data-selected-summary>
          <span>الباقة المختارة</span>
          <strong>—</strong>
        </div>
        <div class="field">
          <label for="snap-username">اسم المستخدم</label>
          <div class="input-wrap">
            <span class="input-prefix" aria-hidden="true">@</span>
            <input
              type="text"
              id="snap-username"
              name="snap-username"
              autocomplete="username"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              maxlength="16"
              inputmode="text"
              placeholder="username"
              aria-describedby="username-hint username-error"
              aria-required="true"
            />
          </div>
          <p class="field-hint" id="username-hint">3–15 حرفًا: حروف إنجليزية أو أرقام أو . _ -</p>
          <p class="field-error" id="username-error" role="alert" aria-live="polite"></p>
        </div>
        <div class="btn-row">
          <button type="button" class="btn btn-primary" id="btn-username-next" disabled>التالي</button>
          <button type="button" class="btn btn-ghost" data-back>رجوع</button>
        </div>
      </div>
    </section>

    <!-- Step 2: Follow Snap -->
    <section class="panel" id="panel-follow" aria-hidden="true" aria-labelledby="follow-title">
      <div class="step-card">
        <h2 id="follow-title">تابع حسابنا على سناب</h2>
        <p class="step-desc">لازم تتابع حساب البائع قبل إكمال الطلب. الرابط يفتح في تبويب جديد.</p>
        <div class="selected-summary" data-selected-summary>
          <span>الباقة المختارة</span>
          <strong>—</strong>
