        </div>
        <a
          class="snap-btn"
          id="snap-follow-link"
          href="https://snapchat.com/t/7BEXzDEV"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="snap-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12.2 2c-.7 0-1.3.2-1.8.6-.4.3-.7.8-.8 1.3-.1.3-.2.7-.3 1.1-.2.8-.3 1.2-.7 1.4-.3.2-.8.2-1.6.3-.5 0-.8.1-1 .3-.3.2-.4.5-.4.9 0 .4.2.8.6 1.1.2.1.3.3.3.5 0 .1-.1.3-.3.6-.5.8-.9 1.7-.9 2.5 0 .5.1.9.4 1.3.2.3.5.5.9.7.1 0 .2.1.2.3 0 .4-.5.7-1.1 1-.6.2-1 .6-1.1 1 0 .3.1.6.3.8.3.3.7.4 1.3.5.2 0 .4.1.5.3.2.3.2.7 0 1.3-.1.3 0 .6.2.8.3.3.8.3 1.5 0 .3-.1.5-.1.7 0 .5.3 1.1.5 1.8.5s1.3-.2 1.8-.5c.2-.1.4 0 .7 0 .7.3 1.2.3 1.5 0 .2-.2.3-.5.2-.8-.2-.6-.2-1 0-1.3.1-.2.3-.3.5-.3.6-.1 1-.2 1.3-.5.2-.2.3-.5.3-.8-.1-.4-.5-.8-1.1-1-.6-.3-1.1-.6-1.1-1 0-.2.1-.3.2-.3.4-.2.7-.4.9-.7.3-.4.4-.8.4-1.3 0-.8-.4-1.7-.9-2.5-.2-.3-.3-.5-.3-.6 0-.2.1-.4.3-.5.4-.3.6-.7.6-1.1 0-.4-.1-.7-.4-.9-.2-.2-.5-.3-1-.3-.8-.1-1.3-.1-1.6-.3-.4-.2-.5-.6-.7-1.4-.1-.4-.2-.8-.3-1.1-.1-.5-.4-1-.8-1.3C13.5 2.2 12.9 2 12.2 2z"/>
          </svg>
          افتح سناب وتابعنا
        </a>
        <label class="check-row" for="check-followed">
          <input type="checkbox" id="check-followed" name="followed" />
          <span>تابعت حسابك ✓</span>
        </label>
        <div class="btn-row">
          <button type="button" class="btn btn-primary" id="btn-follow-next" disabled>التالي</button>
          <button type="button" class="btn btn-ghost" data-back>رجوع</button>
        </div>
      </div>
    </section>

    <!-- Step 3: Payment policy + WhatsApp -->
    <section class="panel" id="panel-payment" aria-hidden="true" aria-labelledby="payment-title">
      <div class="step-card">
        <h2 id="payment-title">سياسة الدفع</h2>
        <p class="step-desc">اقرأ وأوافق قبل إرسال الطلب عبر واتساب.</p>
        <div class="selected-summary" data-selected-summary>
          <span>الباقة المختارة</span>
          <strong>—</strong>
        </div>
        <div class="policy-box">
          <h3>
            <span aria-hidden="true">💳</span>
            طريقة الدفع المقبولة
          </h3>
          <ul class="policy-list">
            <li>
              <span class="policy-icon yes" aria-hidden="true">✓</span>
              <span><span class="policy-highlight">الدفع فقط عبر بنكيلي (Bankily)</span></span>
            </li>
            <li>
              <span class="policy-icon no" aria-hidden="true">✕</span>
              <span>لا نقبل <strong>Gimtel</strong></span>
            </li>
            <li>
              <span class="policy-icon no" aria-hidden="true">✕</span>
              <span>لا نقبل الدفع من طرف ثالث</span>
            </li>
            <li>
              <span class="policy-icon yes" aria-hidden="true">✓</span>
              <span>لا نجمع أرقام بطاقات ولا نعالج الدفع على الموقع — الطلب يُكمَل عبر واتساب</span>
            </li>
          </ul>
        </div>
        <label class="check-row" for="check-payment">
          <input type="checkbox" id="check-payment" name="payment-agree" />
          <span>أوافق: الدفع فقط عبر بنكيلي، ولا Gimtel ولا طرف ثالث</span>
        </label>
        <div class="btn-row">
          <a
            class="btn btn-whatsapp"
            id="btn-whatsapp"
            role="button"
            aria-disabled="true"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M17.5 14.4c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1-.2.2-.7.9-.8 1-.2.1-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.8-1.4-1.7-1.6-2-.1-.3 0-.4.1-.5.1-.1.3-.3.4-.4.1-.1.2-.3.3-.4.1-.1.1-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.4-.2.2-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.7 3 .6.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.1 15 3.6 13.5 3.6 12c0-4.6 3.8-8.4 8.4-8.4s8.4 3.8 8.4 8.4-3.8 8.4-8.4 8.4z"/>
            </svg>
            إرسال الطلب عبر واتساب
          </a>
          <button type="button" class="btn btn-ghost" data-back>رجوع</button>
        </div>
        <p class="privacy-note">
          ملاحظة خصوصية: لا نخزّن بيانات الدفع على هذا الموقع. بعد الموافقة يُفتح واتساب برسالة جاهزة لإكمال الطلب مع البائع.
        </p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>© مرصة — متجر هدايا سناب شات بلس</p>
      <p>الدفع عبر بنكيلي فقط · لا بطاقات على الموقع</p>
    </div>
  </footer>

  <script src="js/config.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
